<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash (SplashScreen API). The app icon vector is
         used as the animated icon so the brand shows instantly. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
